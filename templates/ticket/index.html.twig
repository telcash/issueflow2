{#  Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# 
    Sobreescribimos el título de la página en la plantilla base, usamos la variable title, el
    cual vendrá desde el controlador
#}
{% block title %}{{ title }}{% endblock %}

{# Inserto el cuerpo de la página de /tickets: el listado de todos los tickets #}
{% block body %}
    <div class="page-header">
        <div>
            <p class="eyebrow">IssueFlow</p>
            <h1>{{ title }}</h1>
        </div>
        {# Solo mostramos el acceso de creación a quien pueda usarlo #}
        {% if is_granted('ROLE_AGENT') %}
            <a href="{{ path('app_ticket_new') }}">Nueva incidencia</a>
        {% endif %}
        
        {# 
            ticketPage será suministrado por el controlador
            getTotalCount me calcula la cantidad de tickets totales
        #}
        <p class="counter">{{ ticketPage.getTotalCount() }} incidencias</p>
    </div>
    {#
        Filtro para búsqueda de incidencias 
    #}
    <section class="filter-card">
        {{ form_start(filterForm, { attr: { class: 'filter-form' } }) }}
            {# Campos del formulario #}
            {{ form_row(filterForm.query) }}
            {{ form_row(filterForm.priority) }}
            {{ form_row(filterForm.status) }}
            {{ form_row(filterForm.category) }}

            <div class="filter-actions">
                {{ form_widget(filterForm.filter) }}
                <a class="button button-outline" href="{{ path('app_ticket_index') }}">
                    Limpiar
                </a>
            </div>
        {{ form_end(filterForm) }}
    </section>
    {% if lastTicketCode %}
        <p>
            Última incidencia consultada:
            <a href="{{ path('app_ticket_show', {code: lastTicketCode}) }}">
                {{ lastTicketCode }}
            </a>
        </p>
    {% endif %}
    <div class="ticket-list">
        {#  Recorremos la colección de tickets de la página dada por el paginador #}
        {% for ticket in ticketPage.getItems() %}
            {# 
                Aquí muestro la información para cada uno de los tickets.
                Esta información se mostrará en un diseño típico de card
            #}
            {% include 'ticket/_ticket_card.html.twig' with { ticket: ticket } only %}
        {% else %}
            {# Twig ejecuta este bloque si la colección está vacía #}
            <p>No hay incidencias que coincidan con los criterios de búsqueda</p>
        {% endfor %}
    </div>
    {# Agregamos los controles de navegación del paginador #}
    {# 
        hasToPaginate verifica si hacen falta los controles de página, esto es, si los resultados
        caben en un sola página no harían falta
    #}
    {% if ticketPage.hasToPaginate() %}
        {# Guardo todos los parámetros actuales de la URL #}
        {% set queryParameters = app.request.query.all %}

        <nav class="pagination">
            {# Mostramos el enlace a la página previa sólo si existe una página previa #}
            {% if ticketPage.hasPreviousPage() %}
                <a 
                    class="button button-outline"
                    href="{{ path(
                        'app_ticket_index',
                        queryParameters|merge({ page: ticketPage.getPageNumber() - 1 })
                    ) }}"
                >
                    ← Anterior
                </a>
            {% endif %}
            <span>
                Página {{ ticketPage.getPageNumber() }} de {{ ticketPage.getPageCount() }}
            </span>
            {# Mostramos el enlace a la página siguiente sólo si existe una página siguiente #}
            {% if ticketPage.hasNextPage() %}
                <a 
                    class="button button-outline"
                    href="{{ path(
                        'app_ticket_index',
                        queryParameters|merge({ page: ticketPage.getPageNumber() + 1 })
                    ) }}"
                >
                    Siguiente →
                </a>
            {% endif %}
        </nav>
    {% endif %}
    
{% endblock %}